# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ make python3 \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /app
ENV PORT=8789

# Keep this dependency closure aligned with the Den API image.  The worker
# proxy shares Den's database and utility packages, but does not need the
# desktop or web application source at runtime.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /app/
COPY patches /app/patches
COPY packages/types/package.json /app/packages/types/package.json
COPY packages/automations/package.json /app/packages/automations/package.json
COPY packages/email/package.json /app/packages/email/package.json
COPY packages/enterprise-mcp-client/package.json /app/packages/enterprise-mcp-client/package.json
COPY packages/install-config/package.json /app/packages/install-config/package.json
COPY packages/connect-link/package.json /app/packages/connect-link/package.json
COPY packages/paths/package.json /app/packages/paths/package.json
COPY evals/packages/behaviors/package.json /app/evals/packages/behaviors/package.json
COPY evals/packages/cdp/package.json /app/evals/packages/cdp/package.json
COPY evals/packages/labs/package.json /app/evals/packages/labs/package.json
COPY evals/packages/matchers/package.json /app/evals/packages/matchers/package.json
COPY ee/packages/utils/package.json /app/ee/packages/utils/package.json
COPY ee/packages/den-db/package.json /app/ee/packages/den-db/package.json
COPY ee/apps/den-worker-proxy/package.json /app/ee/apps/den-worker-proxy/package.json

RUN pnpm install --frozen-lockfile --trust-lockfile

COPY packages/types /app/packages/types
COPY ee/packages/utils /app/ee/packages/utils
COPY ee/packages/den-db /app/ee/packages/den-db
COPY ee/apps/den-worker-proxy /app/ee/apps/den-worker-proxy

RUN pnpm --dir /app/ee/packages/utils run build
RUN pnpm --dir /app/ee/packages/den-db run build
RUN pnpm --dir /app/ee/apps/den-worker-proxy run build

EXPOSE 8789

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || '8789') + '/health').then((res) => process.exit(res.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "/app/ee/apps/den-worker-proxy/dist/server.js"]
